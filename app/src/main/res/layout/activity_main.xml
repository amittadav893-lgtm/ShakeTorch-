<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shake your phone to turn the flashlight ON/OFF."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/sensitivityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shake sensitivity: 65"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/sensitivityBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="20"
            android:max="100"
            android:progress="65"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START SHAKE TORCH"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="STOP SERVICE"
            android:textSize="16sp"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After starting, you can return to the Home screen or lock the phone. The foreground service keeps motion detection active."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>
